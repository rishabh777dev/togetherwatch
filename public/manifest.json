{
  "name": "TogetherWatch - Watch Together, Feel Together",
  "short_name": "TogetherWatch",
  "description": "The premium social watching experience. Watch movies, series, and live sports together with friends in perfect sync.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0c",
  "theme_color": "#E50914",
  "lang": "en",
  "categories": ["entertainment", "movies", "social", "video"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Watch Together Party",
      "short_name": "Party",
      "description": "Start a synchronized watch party room",
      "url": "/room/create",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Movies",
      "short_name": "Movies",
      "description": "Browse trending and top movies",
      "url": "/browse?type=movie",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "TV Shows",
      "short_name": "TV Shows",
      "description": "Browse popular series",
      "url": "/browse?type=tv",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Watchlist",
      "short_name": "Watchlist",
      "description": "View saved movies and shows",
      "url": "/watchlist",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
